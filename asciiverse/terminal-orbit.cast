[0.032456, "o", "\u001b[1;3HMiss\u001b[1;8Hon Briefing: train01.msn \u001b[2;2H\u001b[38;5;15;49mTraining Mission #01: One Small Step\u001b[4;2HIn this training session you will learn how to fly your ship.\u001b[6;2HYour objective is to fly from Earth orbit to the Moon and back again.\u001b[39;49m        \u001b[7;23H                                                        \u001b[8;2H\u001b[38;5;15;49mFollow the instructions which will appear on the screen.\u001b[39;49m                     \u001b[9;23H                                                        \u001b[10;2H\u001b[38;5;15;49mPress 'M' at any time to recall the last instruction.\u001b[39;49m                        \u001b[12;2H\u001b[38;5;15;49mBriefing concluded. Good luck!\u001b[12;36H\u001b[39;49m                               \u001b[13;36H                               \u001b[14;36H                               \u001b[15;36H                               \u001b[16;36H                               \u001b[18;26H                                                   \u001b[19;33H                                    \u001b[21;43H                 \u001b[22;43H                 \u001b[23;38H                           \u001b[24;43H                 \u001b[26;30H                                          \u001b[29;2H\u001b[38;5;8;49m  Press any key to begin...\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
